# Nomi delle variabili, senza valori reali. Copia in .env.local.

# Agente AI "live" via Vercel AI Gateway (una delle due).
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=   # in alternativa, dopo `vercel env pull`

# Modello usato dall'agente (stringa provider/modello del Gateway). Default nel codice.
AGENT_MODEL=anthropic/claude-sonnet-4.5

# "mock" = demo offline con risposte precalcolate (dichiarata nella UI). Se vuoto e c'e' una chiave -> live.
AGENT_MODE=

# Percorso del database SQLite locale. Default: data/arke.db
DATABASE_PATH=

# Casella backoffice (etichetta UI oggi; collegamento Gmail reale da fare, vedi docs/HANDOFF.md)
BACKOFFICE_EMAIL=sloplinearkedemo@gmail.com
